{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VerilogLinterRulesConfig",
  "description": "Configuration file schema for STARC/RMM and THERYX Verilog linter rules",
  "type": "object",
  "required": ["version", "rules"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional JSON Schema reference (e.g. the URL of this schema)"
    },
    "version": {
      "type": "string",
      "description": "Ruleset version"
    },
    "rules": {
      "type": "array",
      "description": "List of linter rules",
      "items": {
        "type": "object",
        "required": ["id", "enabled", "severity", "checker", "description"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique rule identifier (e.g., STARC-2.1.1, RMM-2.2)"
          },
          "name": {
            "type": "string",
            "description": "Human-readable name of the rule"
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether this rule is active"
          },
          "severity": {
            "type": "string",
            "enum": ["error", "warning", "info", "hint"],
            "description": "Diagnostic severity level"
          },
          "checker": {
            "type": "string",
            "description": "Internal identifier of the TypeScript checker function. A rule whose checker is unknown (or missing) is reported as a configuration problem and does not run."
          },
          "description": {
            "type": "string",
            "description": "Rule explanation and guidance"
          },
          "params": {
            "type": "object",
            "description": "Optional checker-specific parameters",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
